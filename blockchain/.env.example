# AUTHENTIQ Polygon Amoy deployment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required: RPC URL for Polygon Amoy testnet
# Obtain from a provider (e.g. https://rpc-amoy.polygon.technology or your own node)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Required: Private key of the deployer account (without 0x prefix is accepted, with is fine)
# Use a dedicated low-value testnet key. Never use a mainnet key.
# This key is only read by Hardhat at deploy time; it is never stored on-chain.
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here

# Optional: PolygonScan API key for contract verification on Amoy
POLYGONSCAN_API_KEY=
