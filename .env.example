# AUTHENTIQ environment configuration
# Copy this file to .env (or backend/.env) and fill in your own values.
# NEVER commit .env to version control. It is gitignored via */.env.

# ============================================================================
# REQUIRED — Security (change these in production)
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTHENTIQ_SECRET_KEY=change-me-to-a-32-plus-character-secret

# ============================================================================
# Application
# ============================================================================
AUTHENTIQ_ENVIRONMENT=development
AUTHENTIQ_DEBUG=false
AUTHENTIQ_API_PUBLIC_URL=http://localhost:8000
AUTHENTIQ_PUBLIC_APP_URL=http://localhost:5173
AUTHENTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Optional regex for origins that change per deployment (Vercel preview URLs).
# Example: https://.*\.vercel\.app  — leave empty to allow only the list above.
AUTHENTIQ_CORS_ORIGIN_REGEX=

# ============================================================================
# Database
# ============================================================================
# For local dev you may use SQLite (default): AUTHENTIQ_DATABASE_URL=sqlite:///./authentiq.db
# For PostgreSQL (production / docker):
AUTHENTIQ_DATABASE_URL=postgresql+psycopg://authentiq:CHANGE_ME_PASSWORD@localhost:5432/authentiq?sslmode=require

POSTGRES_DB=authentiq
POSTGRES_USER=authentiq
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD

# ============================================================================
# Polygon Amoy testnet (ledger anchoring)
# ============================================================================
AUTHENTIQ_LEDGER_MODE=simulation
AUTHENTIQ_CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
AUTHENTIQ_CHAIN_PRIVATE_KEY=
AUTHENTIQ_CHAIN_CONTRACT_ADDRESS=
AUTHENTIQ_CHAIN_ID=80002
AUTHENTIQ_CHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# ============================================================================
# ZKP / Groth16 (optional)
# ============================================================================
AUTHENTIQ_ZKP_MODE=sigma
AUTHENTIQ_ZKP_CHALLENGE_MINUTES=10
AUTHENTIQ_ZKP_VERIFICATION_HOURS=72
AUTHENTIQ_GROTH16_WASM=
AUTHENTIQ_GROTH16_ZKEY=
AUTHENTIQ_GROTH16_VKEY=

# ============================================================================
# Rate limiting
# ============================================================================
AUTHENTIQ_LOGIN_RATE_LIMIT=8
AUTHENTIQ_LOGIN_RATE_WINDOW_SECONDS=300
AUTHENTIQ_REGISTRATION_RATE_LIMIT=30
AUTHENTIQ_REGISTRATION_RATE_WINDOW_SECONDS=3600

# ============================================================================
# Demo / dev mode — set false in production
# ============================================================================
AUTHENTIQ_DEMO_MODE=true
AUTHENTIQ_SEED_DEMO=false
AUTHENTIQ_ACCESS_LOG=true
